# use vscode settings here
!.vscode
.vscode/launch.json

# User-specific JetBrains files
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.idea/**/dictionaries
.idea/**/shelf

# Cursor files
.cursor/mcp.json

bin
obj
csx
.vs
edge
Publish
