# Required Variables
resource_group_name = "datadog-log-forwarding-rg"
datadog_api_key    = "your-32-character-datadog-api-key"

# Subscription Configuration - Choose one approach:

# Option 1: Management Group Discovery (Recommended - matches ARM template approach)
use_management_group_discovery = true
management_group_name         = "my-management-group"
excluded_subscriptions        = ["11111111-1111-1111-1111-111111111111"]  # Optional: exclude specific subscriptions

# Option 2: Manual Subscription List
# use_management_group_discovery = false
# monitored_subscriptions = ["12345678-1234-1234-1234-123456789012", "87654321-4321-4321-4321-210987654321"]

# Resource Group Management
create_resource_groups_in_subscriptions = true  # Creates forwarder resource groups in each monitored subscription

# Optional - Provider Configuration
# subscription_id = "12345678-1234-1234-1234-123456789012"  # Defaults to first monitored subscription

# Optional Variables with Common Customizations
location                = "East US"
datadog_site           = "datadoghq.com"
datadog_telemetry      = true
log_level              = "INFO"
resource_tag_filters   = "env:prod,datadog:true,!env:test"
control_plane_id       = "mycontrolplane"  # Set to null or comment out for auto-generated
# control_plane_id     = null              # Uncomment this line for auto-generated ID
resources_task_schedule = "0 */5 * * * *"  # Every 5 minutes
cache_retention_days   = 7

# Container Images Configuration
image_registry        = "datadoghq.azurecr.io"
deployer_image_tag   = "latest"
forwarder_image      = "datadoghq.azurecr.io/forwarder:latest"
pii_scrubber_rules   = ""  # YAML formatted rules for PII scrubbing

# Storage Account URL (optional - auto-generated if not provided)
# storage_account_url = "https://lfostorageXXXXXXXXXXXX.blob.core.windows.net/"

# Application Insights (optional - leave blank to auto-create)
# application_insights_connection_string = "InstrumentationKey=your-key;IngestionEndpoint=https://eastus-0.in.applicationinsights.azure.com/"
# application_insights_instrumentation_key = "your-instrumentation-key"

# Storage Configuration
storage_account_replication_type = "LRS"

# Security Configuration
allowed_origins = []
ip_restrictions = []
# Example IP restriction:
# ip_restrictions = [
#   {
#     ip_address = "192.168.1.0/24"
#     name       = "Office Network"
#     priority   = 100
#     action     = "Allow"
#   }
# ]

# SCM IP restrictions (for Kudu/SCM site)
scm_ip_restrictions = []

# Monitoring and Alerting
enable_monitoring      = true
alert_email_addresses = ["ops-team@company.com", "datadog-alerts@company.com"]

# Backup Configuration (optional)
enable_backup = false
# backup_settings = {
#   name                = "daily-backup"
#   enabled             = true
#   storage_account_url = "https://backupstorage.blob.core.windows.net/backups"
#   frequency_interval  = 1
#   frequency_unit      = "Day"
#   retention_period_in_days = 30
# }

# Advanced Function App Configuration
function_app_always_on           = false  # Not applicable for consumption plan
function_app_use_32_bit_worker  = false

# Tags
tags = {
  Environment          = "production"
  Project             = "datadog-log-forwarding"
  Owner               = "platform-team"
  CostCenter          = "engineering"
  ManagedBy           = "terraform"
  Application         = "log-forwarding-orchestration"
  Component           = "control-plane"
  DataClassification  = "internal"
  BusinessUnit        = "platform"
  Backup              = "required"
  MaintenanceWindow   = "saturday-2am-utc"
}

# Example configurations for different environments:

# Development Environment
# location                = "East US"
# datadog_site           = "datadoghq.com"
# datadog_telemetry      = false
# log_level              = "DEBUG"
# cache_retention_days   = 3
# enable_monitoring      = false
# tags = {
#   Environment = "development"
#   Project     = "datadog-log-forwarding"
#   Owner       = "dev-team"
# }

# Production Environment
# location                = "East US"
# datadog_site           = "datadoghq.com"
# datadog_telemetry      = true
# log_level              = "INFO"
# cache_retention_days   = 14
# enable_monitoring      = true
# storage_account_replication_type = "GRS"
# tags = {
#   Environment = "production"
#   Project     = "datadog-log-forwarding"
#   Owner       = "platform-team"
#   CriticalSystem = "true"
# }

# Multi-region Configuration Example
# For multi-region deployments, you would typically create separate terraform configurations
# or use workspaces with different variable files 