# Example terraform.tfvars file for the prerequisites module
# Copy this file to terraform.tfvars and update the values

# Required Variables
subscription_id       = "12345678-1234-1234-1234-123456789abc"  # The monitored subscription ID
resource_group_name   = "datadog-log-forwarders"               # Must match the main module's var.resource_group_name
location             = "eastus"                                 # Must match the main module's var.location

# Optional Variables
tags = {
  "Environment"   = "production"
  "Owner"         = "platform-team"
  "Project"       = "log-forwarding"
  "CostCenter"    = "12345"
}